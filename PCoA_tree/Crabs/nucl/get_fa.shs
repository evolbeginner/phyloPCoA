#!/bin/bash

# 输入文件（你的SAP.txt）
INPUT_FILE="SAP.txt"
# 输出文件（最终的SAP.fa）
OUTPUT_FILE="SAP.fa"

# 清空输出文件（避免重复内容）
> "$OUTPUT_FILE"

# 逐行读取输入文件（处理每一行的物种名和ID）
while read -r species id; do
    # 跳过空行（如果有的话）
    if [ -z "$species" ] || [ -z "$id" ]; then
        continue
    fi

    echo "正在获取 $species ($id) 的序列..."

    # 1. 用efetch获取ID对应的FASTA序列
    # 2. 用sed替换FASTA的序列名（将原ID替换为物种名）
    efetch -db nucleotide -id "$id" -format fasta | \
    sed "1s/^>.*$/>$species/" >> "$OUTPUT_FILE"

done < "$INPUT_FILE"

echo "所有序列已保存到 $OUTPUT_FILE"
